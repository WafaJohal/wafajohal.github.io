---
layout: default
---

<!-- ── Bio row ── -->
<div class="pv2-bio-row">
  {% if page.profile and page.profile.image %}
    {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
    <img
      src="{{ profile_image_path | relative_url }}"
      alt="{{ site.first_name }} {{ site.last_name }}"
      class="pv2-bio-photo"
    />
  {% endif %}
  <div class="pv2-bio-text-block">
    <div class="pv2-bio-name">{{ site.first_name }} {{ site.last_name }}</div>
    <div class="pv2-bio-role">{{ page.subtitle }}</div>
    <div class="pv2-bio-body">{{ content }}</div>
    {% if page.research_line %}
      <p class="pv2-research-line">{{ page.research_line }}</p>
    {% endif %}
    {% if page.bio_links %}
      <div class="pv2-bio-links">
        {% for link in page.bio_links %}
          <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<!-- ── Selected Publications ── -->
{% if page.selected_papers %}
  <div id="publications">
    <div class="pv2-sec-title">Selected Publications</div>
    <div class="pv2-selected-pubs">
      {% include selected_papers.liquid %}
    </div>
    <div class="pv2-more-pubs">
      <a href="{{ '/publications/' | relative_url }}">Full publication list &nbsp;→</a>
    </div>
  </div>
{% endif %}

<!-- ── Research Projects ── -->
{% if site.data.projects %}
  <div id="projects">
    <div class="pv2-sec-title">Research Projects</div>
    <div class="pv2-project-grid">
      {% for project in site.data.projects %}
        <div class="pv2-proj-card">
          {% if project.url %}
            <div class="pv2-proj-name"><a href="{{ project.url }}" target="_blank" rel="noopener noreferrer">{{ project.name }}</a></div>
          {% else %}
            <div class="pv2-proj-name">{{ project.name }}</div>
          {% endif %}
          <div class="pv2-proj-desc">{{ project.desc }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}
